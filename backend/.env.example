# 飞书多维表格对接配置
# 获取方式：
# 1. 前往 https://open.feishu.cn 创建企业自建应用
# 2. 在"凭证与基础信息"页面获取 App ID 和 App Secret
# 3. 在"权限管理"中开通以下权限：
#    - bitable:app          (多维表格读写)
#    - bitable:app:create   (创建多维表格)
# 4. 将应用发布到企业，并确保应用有访问多维表格的权限
# 5. 将本文件复制为 .env 并填入真实值

FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 多维表格 app_token（可选）
# 留空时系统会自动创建一个新的多维表格，并在控制台输出 app_token
# 建议首次创建后填回此处，避免重复创建
FEISHU_APP_TOKEN=

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
