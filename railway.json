{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python3 -m venv venv && venv/bin/pip install -r backend/requirements.txt"
  },
  "deploy": {
    "startCommand": "PYTHONPATH=backend venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE"
  }
}